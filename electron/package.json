{
    "name": "motion-base",
    "productName": "Motion Base",
    "version": "1.0.0",
    "description": "Desktop shell for the Motion Base strong-motion database",
    "main": "index.js",
    "private": true,
    "scripts": {
        "build:ui": "node scripts/build-ui.js",
        "start": "node scripts/build-ui.js && electron-forge start",
        "package": "node scripts/build-ui.js && electron-forge package",
        "portable": "node scripts/build-ui.js && electron-forge make --targets @electron-forge/maker-zip",
        "make": "node scripts/build-ui.js && electron-forge make",
        "publish": "node scripts/build-ui.js && electron-forge publish",
        "format": "prettier --write ."
    },
    "author": {
        "name": "Theodore Chang",
        "email": "tlcfem@gmail.com"
    },
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/TLCFEM/motion-base",
    "devDependencies": {
        "@electron-forge/cli": "^7.11.2",
        "@electron-forge/maker-deb": "^7.11.2",
        "@electron-forge/maker-rpm": "^7.11.2",
        "@electron-forge/maker-squirrel": "^7.11.2",
        "@electron-forge/maker-zip": "^7.11.2",
        "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
        "@electron-forge/plugin-fuses": "^7.11.2",
        "@electron/fuses": "^2.1.3",
        "electron": "^44.9.3",
        "prettier": "^3.9.10"
    },
    "dependencies": {
        "electron-squirrel-startup": "^1.0.1"
    },
    "volta": {
        "node": "24.22.1"
    }
}
