# Optional Cloudflare Turnstile site key override.
# The front end ships with the public Motion Base site key.
# For local development against a backend without Turnstile, use Cloudflare's always-pass test key:
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# See https://developers.cloudflare.com/turnstile/get-started/client-side-rendering/
VITE_TURNSTILE_SITE_KEY=

# Turnstile is disabled during development and enabled for production builds by default.
# Set to true to test verification with `npm run dev`, or false to disable it in a production build.
VITE_TURNSTILE_ENABLED=
